#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'tooling'

HELP = <<~TEXT
  Usage: tools/commit [--full] <message>

  Run the gate, then stage every change (git add -A) and commit it as
  <message>. Nothing is pushed and the version is not bumped.

  The fast gate is formatting, go mod tidy, go vet, staticcheck, go-audit, the
  architecture and version checks, every test, and the build. A release also
  runs the full gate, so a commit that passes only the fast gate can still stop
  a release.

  Options:
    --full      Run the full gate: adds -race, govulncheck, gocritic, shadow,
                revive and dupl.
    -h, --help  Show this help; nothing is run.
TEXT

Tooling.entry(HELP) do
  full = ARGV.first == '--full'
  ARGV.shift if full
  abort 'Usage: tools/commit [--full] <message>' unless ARGV.length == 1
  Tooling.commit(Tooling.commit_message(ARGV.first), full)
end
