#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'tooling'

# Adapted from the template. The template treats installation as a separate
# request (`--install`); here a release installs the built binary to ~/bin,
# because the installed binary is what a release is for. Pass --no-install to
# publish the version, the commit and the tag without touching ~/bin.
HELP = <<~TEXT
  Usage: tools/release [--no-install] <message>
         tools/release [--no-install]             (clean working tree)

  Publish a release: commit, bump the version, push, tag, install.

    1. Commit the pending work as <message>, after the fast gate (tools/commit).
       With a clean tree there is nothing to commit; leave <message> out and
       the current HEAD is released.
    2. Bump the patch version in VERSION, sync app/constants.go, regenerate
       docs/clihelp, run the full gate, commit "chore: bump version to X.Y.Z"
       and push it, verified (tools/bump).
    3. Publish the vX.Y.Z tag, verified; GitHub then creates the release
       (tools/tag).
    4. Install the built binary to ~/bin/feral (tools/install).

  Steps 1-3 change the remote repository and are not undone by rerunning. If a
  step fails, the message says what was published; an interrupted bump is
  finished with tools/bump --resume, an unpublished tag with tools/tag.

  Options:
    --no-install  Publish without installing to ~/bin.
    -h, --help    Show this help; nothing is run.
TEXT

Tooling.entry(HELP) do
  install_requested = ARGV.first != '--no-install'
  ARGV.shift unless install_requested
  clean = Tooling.git('status', '--porcelain').empty?
  # The message is the commit for pending work, so a clean tree needs none.
  usable = ARGV.length == 1 && !ARGV.first.strip.empty?
  abort 'Usage: tools/release [--no-install] <message>' unless usable || (clean && ARGV.empty?)
  # Tooling.release commits pending work first, which needs work to commit. A
  # release with a clean tree versions what is already committed, so run the
  # bump script rather than failing on an empty commit. It must be the script,
  # not Tooling.bump: publishing the v* tag is that entry point's step.
  if clean
    puts 'Nothing to commit; releasing the current tree'
    Tooling.script('bump')
    Tooling.script('install') if install_requested
  else
    Tooling.release(Tooling.commit_message(ARGV.first), install_requested)
  end
end
